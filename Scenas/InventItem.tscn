script/source = "extends TextureRect

signal item_selected(name)
var item_name

func _ready():
	pass

func set_item(name, amount):
	item_name = name
	texture = load(\"res://Images/Items/%s.png\" % name)
	$Amount.text = str(amount)

func _on_click():
	Events.emit_signal(Events.ITEM_SELECT, item_name)

