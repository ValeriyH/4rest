[sub_resource type="GDScript" id=1]
script/source = "extends StaticBody2D

export var growing_interval = 1
export var growing_scale = 0.1
export var seed_interval_min = 30
export var seed_interval_max = 180

enum State {
	GROWING,
	ADULT,
	BURN
}
export(State) var state = State.GROWING

signal seed_dropped(tree_item)

onready var tween: SceneTreeTween = create_tween().set_loops() # Infinite loop

func _ready():
	randomize()
	var i = int(rand_range(1,3))
	if i == 1:
		$Tree1.show()
	else:
		$Tree2.show()
	if state == State.GROWING:
		scale.x = 0.3
		scale.y = 0.3
	set_timer()
	Events.emit_signal(Events.TREE_PLANT, self)
	start_swaying()

func set_timer():
	if state == State.GROWING:
		#Set timer to next growing size
		$Timer.start(growing_interval)
	elif state == State.ADULT:
		#Set timer to next seed
		$Timer.start(int(rand_range(seed_interval_min, seed_interval_max)))
	#No timer for burned object

func burn(_fire):
	if state == State.BURN:
		return
	collision_layer = Global.Layers.UNFIREABLE
	state = State.BURN
	
	$FireParticles.emitting = true
	tween.tween_property(self, \"modulate\", Color(0, 0, 0, 0), 0.8)
	yield(get_tree().create_timer(1.0), \"timeout\")
	$FireParticles.emitting = false
	
	$Tree1.hide()
	$Tree2.hide()
	$Burn1.show()
	
	Events.emit_signal(Events.TREE_BURN, self)
	if tween != null:
		tween.kill()
		tween = null

func start_swaying():
	# Swing right over 2 seconds with a smooth ease
	tween.tween_property(self, \"rotation_degrees\", 2.0, 2.0).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
	
	# Swing left over 2 seconds
	tween.tween_property(self, \"rotation_degrees\", -2.0, 2.0).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)

func _on_Timer_timeout():
	if state == State.GROWING:
		if scale.x < 1:
			scale.x += growing_scale
			scale.y += growing_scale
		if scale.x >= 1:
			scale.x = 1
			scale.y = 1
			state = State.ADULT
	elif state == State.ADULT:
		#print(name, \" drops seed\")
		emit_signal(\"seed_dropped\", self)
	set_timer()
"

