[sub_resource type="GDScript" id=1]
script/source = "extends Button

func _ready():
	Events.connect(Events.ITEM_SELECT, self, \"_on_item_select\")

func _on_action_button_down():
	Input.action_press(\"ui_action\")

func _on_action_button_up():
	Input.action_release(\"ui_action\")
	
func _on_item_select(item):
	var img = load(\"res://Images/Items/%s.png\" % item)
	icon = img
"

