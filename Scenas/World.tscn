[gd_scene load_steps=9 format=2]

[ext_resource path="res://Scenas/Player.tscn" type="PackedScene" id=1]
[ext_resource path="res://Images/WorldTiles.tres" type="TileSet" id=2]
[ext_resource path="res://Scenas/Tree.tscn" type="PackedScene" id=3]
[ext_resource path="res://Scenas/Stone.tscn" type="PackedScene" id=4]
