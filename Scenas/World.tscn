[sub_resource type="GDScript" id=1]
script/source = "extends Node2D

# Load template
onready var Item = preload(\"res://Scenas/Item.tscn\")
onready var TreeTemplate = preload(\"res://Scenas/Tree.tscn\")
onready var main = Global.get_main()

func _ready():
	randomize()
	var items = [\"seed\", \"heart\", \"icecream\", \"extinguisher\"]
	var items_count = 0
	var rect = main.get_world_rect() as Rect2
	while items_count < 50:
		var item_position = Vector2(
				int(rand_range(rect.position.x, rect.end.x)), 
				int(rand_range(rect.position.y, rect.end.y)))
		var i = int (rand_range(0, items.size()))
		if add_item(items[i], item_position):
			items_count += 1
		
	# Note: It is for predefined trees, dynamically created trees connect signal by themself
	for t in get_tree().get_nodes_in_group(\"Trees\"):
		t.connect(\"seed_dropped\", self, \"_on_seed_dropped\")

	#Plant tree
	var trees = 0
	while trees < 50:
		var position = Vector2(
				int(rand_range(rect.position.x, rect.end.x)), 
				int(rand_range(rect.position.y, rect.end.y)))
		if add_plant(position):
			trees += 1
	
func has_overlaps_point(global_coords:Vector2, layer: int = 0x7FFFFFFF):
	var space_state = get_world_2d().direct_space_state
	var result = space_state.intersect_point(global_coords, 1, [], layer)
	return !result.empty()
	
func add_plant(global_coords):
	var should_plant = !has_overlaps_point(global_coords)
	if should_plant:
		var new_tree = TreeTemplate.instance()
		$Nature.add_child(new_tree)
		new_tree.set_global_position(global_coords)
		new_tree.connect(\"seed_dropped\", self, \"_on_seed_dropped\")
		print_tree_statistic()
	return should_plant

func add_item(item_name : String, item_position : Vector2):
	var layer = Global.Layers.ITEM | Global.Layers.STONE | Global.Layers.WATER
	var can_add = !has_overlaps_point(item_position, layer)
	if can_add:
		var new_item = Item.instance()
		new_item.set_item(item_name)
		$Items.add_child(new_item)
		new_item.global_position = item_position
	return can_add
	
func print_tree_statistic():
	var burned = 0
	var alive = 0
	for item in get_tree().get_nodes_in_group(\"Trees\"):
		if item.state == item.State.BURN:
			burned += 1
		else:
			alive += 1
	print(\"Alive trees \", alive, \" Burned \", burned)


func _on_seed_dropped(tree):
	add_item(\"seed\", tree.global_position)
	#print(\"seed added from \", tree.name)


"

